#
# Internal development template
# Copy to .env.local (or set in Railway Variables for deployed environments)
#

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Notion OAuth
NOTION_CLIENT_ID="your_notion_client_id"
NOTION_CLIENT_SECRET="your_notion_client_secret"
NOTION_REDIRECT_URI="http://localhost:3000/api/auth/callback/notion"

# Public URL used for generated ICS links
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional admin dashboard token
ADMIN_TOKEN="replace_with_long_random_token"

# Sync controls
NOTION_SYNC_MAX_ITEMS="2000"
NOTION_SYNC_LOOKBACK_DAYS="3"

# Optional environment label
# local | staging | production
APP_ENV="local"
